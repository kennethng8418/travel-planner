# FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Unsplash access key for destination photos in the trip banner (server-only, optional).
# Get one free at https://unsplash.com/developers — without it the banner uses a plain gradient.
# UNSPLASH_ACCESS_KEY=

# Show "Preview demo trip" in production builds (optional)
# NEXT_PUBLIC_DEV_TOOLS=true
